 {
  "name": "lignes : calcul et ligne vide ignorée",
  "field": {
   "key": "c",
   "label": "C",
   "type": "custom",
   "control": {
    "ref": "ctl",
    "version": "1.0.0",
    "name": "C",
    "spec": {
     "version": 1,
     "mode": "repeat",
     "min": 1,
     "max": 3,
     "parts": [
      {
       "key": "produit",
       "label": "Produit",
       "type": "text",
       "required": true
      },
      {
       "key": "qte",
       "label": "Qte",
       "type": "number",
       "required": true,
       "min": 1
      },
      {
       "key": "prix",
       "label": "Prix",
       "type": "number"
      },
      {
       "key": "total",
       "label": "Total",
       "type": "number",
       "compute": "{qte} * {prix}"
      }
     ]
    }
   }
  },
  "value": [
   {
    "produit": "A",
    "qte": 2,
    "prix": 5,
    "total": 999
   },
   {},
   {
    "produit": "B",
    "qte": 1,
    "prix": 3
   }
  ],
  "expected": {
   "value": [
    {
     "produit": "A",
     "qte": 2,
     "prix": 5,
     "total": 10
    },
    {
     "produit": "B",
     "qte": 1,
     "prix": 3,
     "total": 3
    }
   ],
   "problem": ""
  }
 },
