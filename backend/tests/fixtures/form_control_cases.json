 {
  "name": "sous-champs : règle masque et calcul",
  "field": {
   "key": "c",
   "label": "C",
   "type": "custom",
   "control": {
    "ref": "ctl",
    "version": "1.0.0",
    "name": "C",
    "spec": {
     "version": 1,
     "mode": "group",
     "parts": [
      {
       "key": "type",
       "label": "Type",
       "type": "select",
       "options": [
        {
         "value": "pro",
         "label": "Pro"
        },
        {
         "value": "perso",
         "label": "Perso"
        }
       ]
      },
      {
       "key": "societe",
       "label": "Societe",
       "type": "text",
       "rules": [
        {
         "name": "r",
         "when": {
          "field": "type",
          "op": "equals",
          "value": "pro"
         },
         "then": [
          {
           "do": "show"
          },
          {
           "do": "require"
          }
         ],
         "else": [
          {
           "do": "hide"
          }
         ]
        }
       ]
      },
      {
       "key": "code",
       "label": "Code",
       "type": "text",
       "compute": "upper(left({societe}, 3))"
      }
     ]
    }
   }
  },
  "value": {
   "type": "perso",
   "societe": "caché"
  },
  "expected": {
   "value": {
    "type": "perso"
   },
   "problem": ""
  }
 },
