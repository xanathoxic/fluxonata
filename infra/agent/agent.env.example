# Configuration de l'agent distant (copier en `agent.env`, droits 600). AUCUN secret ici : le jeton est dans un fichier à part (secrets/runner_token).
# Rien du plan de contrôle ne doit être copié sur cette machine.
ORCH_URL=https://runners.exemple.org:8443
ORCH_RUNNER_CONCURRENCY=2
# Autorité de certification d'un HTTPS interne (chemin dans le conteneur) ; laisser vide pour une autorité publique.
ORCH_CA_FILE_IN_CONTAINER=
# Images d'exécution autorisées, ÉPINGLÉES PAR DIGEST (scripts/pin-images.sh --write infra/agent/agent.env). L'agent refuse de démarrer sinon.
ORCH_PYTHON_IMAGE=
ORCH_NODE_IMAGE=
ORCH_POWERSHELL_IMAGE=
# Démon Docker de CETTE machine : socket rootful par défaut, ou socket rootless (/run/user/<uid>/docker.sock).
AGENT_DOCKER_SOCKET=/var/run/docker.sock
AGENT_WORK_DIR=/var/lib/fluxonata-agent
