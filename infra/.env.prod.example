# Template only. scripts/prod-init.sh creates infra/.env.prod with generated values. NEVER commit .env.prod.
ORCH_DEBUG=0
ORCH_SECRET_KEY=
ORCH_ALLOWED_HOSTS=localhost,127.0.0.1
ORCH_TRUSTED_ORIGINS=http://localhost:8080
ORCH_DB_HOST=db
ORCH_DB_PORT=5432
ORCH_DB_NAME=fluxonata
ORCH_DB_USER=fluxonata
ORCH_DB_PASSWORD=
ORCH_RUNNER=docker
ORCH_WORK_DIR=/srv/fluxonata-work
ORCH_EGRESS_TEST_NETWORK=fluxonata-prod-egress
# Plain HTTP evaluation only; keep unset behind TLS:
ORCH_INSECURE_COOKIES=1
# Jeton de l'agent d'exécution (topologie par agents, docker-compose.agent.yml). Généré par scripts/prod-init.sh ; enregistré par `manage.py runner_bootstrap`.
ORCH_EXEC_AGENT_TOKEN=
