# Fluxonata backend images (AR2.5). Two build targets from the same sources:
#   runtime : API (gunicorn), orchestrator, migrate — NO docker CLI (nothing there starts containers; less to exploit on the Internet-facing side).
#   exec    : runtime + docker CLI, for the worker only (it starts isolated action containers on the host daemon). It is the LAST stage,
#             so a plain `docker build` (no --target) still gives the historical image.
FROM python:3.13-slim AS runtime
ARG ORCH_VERSION=0.1.0-dev
ARG ORCH_REVISION=
LABEL org.opencontainers.image.title="fluxonata-backend" org.opencontainers.image.version=$ORCH_VERSION org.opencontainers.image.revision=$ORCH_REVISION org.opencontainers.image.licenses="Apache-2.0"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY backend /app/backend
COPY workers /app/workers
RUN useradd --system --uid 10001 --home /nonexistent fluxonata && mkdir -p /app/var /keys && chown -R fluxonata /app/var /keys
USER fluxonata
WORKDIR /app/backend
ENV DJANGO_SETTINGS_MODULE=fluxonata.settings ORCH_KEY_DIR=/keys ORCH_ARTIFACTS_DIR=/app/var/artifacts ORCH_VERSION=$ORCH_VERSION ORCH_REVISION=$ORCH_REVISION
CMD ["gunicorn", "fluxonata.wsgi", "-b", "0.0.0.0:8000", "-w", "2", "--worker-class", "gthread", "--threads", "8", "--timeout", "60", "--access-logfile", "-"]

FROM runtime AS exec
USER root
RUN apt-get update && apt-get install -y --no-install-recommends docker-cli && rm -rf /var/lib/apt/lists/*
USER fluxonata
