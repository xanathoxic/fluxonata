# Copied to .env by scripts/dev-up.sh (which also generates ORCH_SECRET_KEY). Never commit .env.
ORCH_DEBUG=1
ORCH_SECRET_KEY=
ORCH_ALLOWED_HOSTS=localhost,127.0.0.1
ORCH_DB_HOST=127.0.0.1
ORCH_DB_PORT=5433
ORCH_DB_NAME=fluxonata
ORCH_DB_USER=fluxonata
# Throwaway dev value matching infra/docker-compose.yml
ORCH_DB_PASSWORD=fluxonata-dev
ORCH_API_PORT=8100
ORCH_WEB_PORT=5173
# docker (isolated container, default) | subprocess (dev/tests only, NOT isolated)
ORCH_RUNNER=docker
ORCH_PYTHON_IMAGE=python:3.13-slim
# Dev/E2E only: the code default is 10/min
ORCH_LOGIN_RATE=60/min
